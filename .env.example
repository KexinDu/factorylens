MODEL_PATH=ml/artifacts/classifier.joblib
ANOMALY_MODEL_PATH=ml/artifacts/anomaly_model.joblib
METADATA_PATH=ml/artifacts/model_metadata.json
DATA_PATH=data/processed/hydraulic_cycles.csv
DATABASE_PATH=data/machineguard.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8080
LOG_LEVEL=INFO
WARNING_THRESHOLD=0.25
HIGH_RISK_THRESHOLD=0.60
MAX_UPLOAD_BYTES=2000000
OPENAI_API_KEY=
OPENLUX_API_KEY=
LLM_PROVIDER=openai
# Leave blank to use the selected provider's official endpoint.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
LLM_TOOL_MAX_OUTPUT_TOKENS=1200
LLM_FINAL_MAX_OUTPUT_TOKENS=4000
KNOWLEDGE_MAX_UPLOAD_BYTES=131072
KNOWLEDGE_CHUNK_LENGTH=800
KNOWLEDGE_CHUNK_OVERLAP=100
